diff --git a/src/picotorrent/api/libpico.cpp b/src/picotorrent/api/libpico.cpp
index a56ef51..8b40da8 100644
--- a/src/picotorrent/api/libpico.cpp
+++ b/src/picotorrent/api/libpico.cpp
@@ -1,6 +1,16 @@
 #include "libpico_impl.hpp"
 
+#ifdef __WXOPENLAYOUT__
+// No DLLs on AmigaOS: a plugin's module is its init function, and
+// IPlugin::Load finds none (Application only looks for Plugin*.dll)
+typedef libpico_init_t HMODULE;
+static libpico_init_t GetProcAddress(HMODULE module, const char*)
+{
+    return module;
+}
+#else
 #include <Windows.h>
+#endif
 
 #include <vector>
 
@@ -78,10 +88,15 @@ IPlugin::~IPlugin()
 
 IPlugin* IPlugin::Load(fs::path const& p, pt::Core::Environment* env, pt::Core::Configuration* cfg)
 {
+#ifdef __WXOPENLAYOUT__
+    (void)p; (void)env; (void)cfg;
+    return nullptr;
+#else
     return new Plugin(
         LoadLibrary(p.wstring().c_str()),
         env,
         cfg);
+#endif
 }
 
 libpico_result_t libpico_config_get(libpico_plugin_t* plugin, libpico_config_t** config)
@@ -167,7 +182,12 @@ libpico_result_t libpico_i18n(const char* key, wchar_t* target, size_t* len)
 
 libpico_result_t libpico_mainwnd_native_handle(libpico_mainwnd_t* wnd, void** handle)
 {
+#ifdef __WXOPENLAYOUT__
+    // the toolkit's native handle: the frame's Intuition window
+    *handle = reinterpret_cast<void*>(reinterpret_cast<pt::UI::MainFrame*>(wnd)->GetHandle());
+#else
     *handle = reinterpret_cast<pt::UI::MainFrame*>(wnd)->GetHWND();
+#endif
     return libpico_ok;
 }
 
