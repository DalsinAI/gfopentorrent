 void Database::GetKnownFolderPath(sqlite3_context* ctx, int argc, sqlite3_value** argv)
 {
+#ifdef __WXOPENLAYOUT__
+    // the download drawer (compat/gfot_db.cpp); NULL for any other folder
+    auto env = static_cast<pt::Core::Environment*>(sqlite3_user_data(ctx));
+    if (argc > 0 && env && sqlite3_value_text(argv[0]))
+    {
+        std::string res;
+        std::string downloads = env->GetKnownFolderPath(pt::Core::Environment::KnownFolder::UserDownloads).string();
+        if (gfot::db::known_folder_path((const char*)sqlite3_value_text(argv[0]), downloads, res))
+        {
+            sqlite3_result_text(ctx, res.c_str(), -1, SQLITE_TRANSIENT);
+        }
+    }
+#else
