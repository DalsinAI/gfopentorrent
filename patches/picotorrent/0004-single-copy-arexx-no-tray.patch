 void Application::WaitForPreviousInstance(long pid)
 {
+#ifdef __WXOPENLAYOUT__
+    // no process ids to wait on: wait for the old copy's port to go
+    (void)pid;
+    gfot::rexx::wait_gone(10000);
+#else
     HANDLE hProc = OpenProcess(SYNCHRONIZE, FALSE, pid);
     if (hProc == NULL) { return; }
     WaitForSingleObject(hProc, 10000);
     CloseHandle(hProc);
+#endif
 }
