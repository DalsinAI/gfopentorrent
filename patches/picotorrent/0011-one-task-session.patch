@@ -275,7 +279,18 @@ Session::Session(wxEvtHandler* parent, std::shared_ptr<pt::Core::Database> db, s
     sp.settings = getSettingsPack(cfg);
     sp.ip_filter = ipf;
 
+#ifdef __WXOPENLAYOUT__
+    // One task: the session runs on the program's own io_context (no network
+    // thread), disk work and hashing on it too, and a wx timer polls it while
+    // the UI waits (compat/gfot_loop.cpp)
+    sp.settings.set_int(lt::settings_pack::hashing_threads, 0);
+    sp.settings.set_int(lt::settings_pack::aio_threads, 0);
+    sp.disk_io_constructor = lt::posix_disk_io_constructor;
+    m_session = std::make_unique<lt::session>(sp, gfot::loop::io());
+    gfot::loop::start_pump();
+#else
     m_session = std::make_unique<lt::session>(sp);
+#endif
     m_session->add_extension(&lt::create_ut_metadata_plugin);
     m_session->add_extension(&lt::create_smart_ban_plugin);
 
@@ -325,6 +340,9 @@ Session::~Session()
     if (m_filterLoader.joinable()) m_filterLoader.join();
 
     m_session->set_alert_notify([] {});
+#ifdef __WXOPENLAYOUT__
+    gfot::loop::stop_pump();
+#endif
     m_timer->Stop();
     m_resumeDataTimer->Stop();
 
@@ -1058,7 +1076,12 @@ void Session::SaveTorrents()
 
     while (numOutstandingResumeData > 0)
     {
+#ifdef __WXOPENLAYOUT__
+        // waiting would stop the one task the session runs on: poll it
+        lt::alert const* tmp = gfot::loop::wait_for_alert(*m_session, 10000);
+#else
         lt::alert const* tmp = m_session->wait_for_alert(lt::seconds(10));
+#endif
         if (tmp == nullptr) { continue; }
 
         std::vector<lt::alert*> alerts;
