diff --git a/src/picotorrent/ui/console.cpp b/src/picotorrent/ui/console.cpp
index d944098..c646903 100644
--- a/src/picotorrent/ui/console.cpp
+++ b/src/picotorrent/ui/console.cpp
@@ -1,5 +1,9 @@
 #include "console.hpp"
 
+#ifdef __WXOPENLAYOUT__
+#include <wx/artprov.h>
+#endif
+
 #include "filters/pqltorrentfilter.hpp"
 #include "ids.hpp"
 #include "models/torrentlistmodel.hpp"
@@ -17,10 +21,17 @@ Console::Console(wxWindow* parent, wxWindowID id, pt::UI::Models::TorrentListMod
     m_input->SetFont(
         wxFont(9, wxFONTFAMILY_TELETYPE, wxFONTSTYLE_NORMAL, wxFONTWEIGHT_NORMAL, false, wxT("Consolas")));
 
+#ifdef __WXOPENLAYOUT__
+    // no Windows resources: the toolkit's own art
+    wxIcon funnel = wxArtProvider::GetIcon(wxART_FIND, wxART_OTHER, FromDIP(wxSize(16, 16)));
+#else
     wxIcon funnel(L"ICO_TERMINAL", wxBITMAP_TYPE_ICO_RESOURCE, FromDIP(16), FromDIP(16));
+#endif
 
+#ifndef __WXOPENLAYOUT__
     int i = FromDIP(16);
     printf("%d", i);
+#endif
 
     wxBoxSizer* sizer = new wxBoxSizer(wxHORIZONTAL);
     sizer->Add(new wxStaticBitmap(this, wxID_ANY, funnel), 0, wxALIGN_CENTER | wxLEFT, FromDIP(4));
