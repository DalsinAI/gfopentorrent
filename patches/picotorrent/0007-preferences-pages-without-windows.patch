@@ -2,9 +2,16 @@
 
 #include <sstream>
 
+#ifdef __WXOPENLAYOUT__
+#include <libtorrent/enum_net.hpp>
+#include <libtorrent/io_context.hpp>
+
+#include "gfot_netif.hpp"
+#else
 #include <WinSock2.h>
 #include <WS2tcpip.h>
 #include <iphlpapi.h>
+#endif
 
 #include <wx/hyperlink.h>
 #include <wx/statbmp.h>
@@ -131,6 +138,35 @@ void ListenInterfaceDialog::LoadAdapters()
         m_adapters->GetCount(),
         new ClientData<NetworkAdapter>(any6));
 
+#ifdef __WXOPENLAYOUT__
+    // the TCP/IP stack's interfaces, through libtorrent (compat/gfot_netif.cpp)
+    {
+        lt::io_context ios;
+        lt::error_code ec;
+        std::vector<gfot::netif::iface> ifs;
+        for (lt::ip_interface const& i : lt::enum_net_interfaces(ios, ec))
+        {
+            gfot::netif::iface n;
+            n.address = i.interface_address.to_string();
+            n.v6 = i.interface_address.is_v6();
+            n.up = bool(i.flags & lt::if_flags::up);
+            n.loopback = i.interface_address.is_loopback() || bool(i.flags & lt::if_flags::loopback);
+            n.name = i.name;
+            n.friendly_name = i.friendly_name;
+            ifs.push_back(n);
+        }
+        for (gfot::netif::adapter const& a : gfot::netif::adapters(ifs))
+        {
+            NetworkAdapter na;
+            na.address = a.address;
+            na.name = a.name;
+            m_adapters->Insert(
+                na.name,
+                m_adapters->GetCount(),
+                new ClientData<NetworkAdapter>(na));
+        }
+    }
+#else
     static constexpr int MAX_GETADAPTERSADDRESSES_TRIES = 10;
     static constexpr int INITIAL_BUFFER_SIZE = 15000;
 
@@ -214,4 +250,5 @@ void ListenInterfaceDialog::LoadAdapters()
             }
         }
     }
+#endif
 }
