diff --git a/include/libtorrent/aux_/file_pointer.hpp b/include/libtorrent/aux_/file_pointer.hpp
index b7c181c..c8aa181 100644
--- a/include/libtorrent/aux_/file_pointer.hpp
+++ b/include/libtorrent/aux_/file_pointer.hpp
@@ -36,6 +36,8 @@ POSSIBILITY OF SUCH DAMAGE.
 #include <cstdio>
 #include <utility> // for swap
 #include <cstdint>
+#include <cerrno>
+#include <limits>
 
 #include "libtorrent/config.hpp"
 
@@ -64,6 +66,16 @@ inline int portable_fseeko(FILE* const f, std::int64_t const offset, int const w
 {
 #ifdef TORRENT_WINDOWS
 	return ::_fseeki64(f, offset, whence);
+#elif defined TORRENT_AMIGA
+	// libnix's fseek() takes a 32-bit long, as dos.library's Seek() does:
+	// an offset it can't hold is EFBIG, not a seek to the wrong place
+	if (offset > std::int64_t(std::numeric_limits<std::int32_t>::max())
+		|| offset < std::int64_t(std::numeric_limits<std::int32_t>::min()))
+	{
+		errno = EFBIG;
+		return -1;
+	}
+	return ::fseek(f, static_cast<long>(offset), whence);
 #elif TORRENT_HAS_FSEEKO
 	return ::fseeko(f, offset, whence);
 #else
