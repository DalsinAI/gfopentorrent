+#elif TORRENT_USE_UDP_ROUTE
+		// No route table call: a route to each interface's own subnet, and a
+		// default route on the interface a connected UDP socket picks for a
+		// global address (connect() sends nothing). The gateway isn't known,
+		// so NAT-PMP has no router to ask; UPnP finds its own by multicast.
+		std::vector<ip_interface> const ifs = enum_net_interfaces(ios, ec);
+		if (ec) return ret;
+		for (auto const& i : ifs)
+		{
+			if (!i.interface_address.is_v4()) continue;
+			if (!(i.flags & if_flags::up)) continue;
+			ip_route r;
+			address_v4::bytes_type a = i.interface_address.to_v4().to_bytes();
+			address_v4::bytes_type const m = i.netmask.to_v4().to_bytes();
+			for (std::size_t k = 0; k < a.size(); ++k) a[k] &= m[k];
+			r.destination = address_v4(a);
+			r.netmask = i.netmask;
+			r.gateway = address_v4();
+			r.source_hint = i.interface_address;
+			std::strncpy(r.name, i.name, sizeof(r.name) - 1);
+			r.mtu = 1500;
+			ret.push_back(r);
+		}
+		{
+			error_code uec;
+			udp::socket s(ios);
+			s.open(udp::v4(), uec);
+			// 8.8.8.8 stands for any global address: no packet is sent
+			if (!uec) s.connect(udp::endpoint(make_address_v4("8.8.8.8"), 53), uec);
+			udp::endpoint const local = uec ? udp::endpoint() : s.local_endpoint(uec);
+			if (!uec && !local.address().is_unspecified())
+			{
+				auto const it = std::find_if(ifs.begin(), ifs.end()
+					, [&](ip_interface const& i) { return i.interface_address == local.address(); });
+				if (it != ifs.end())
+				{
+					ip_route r;
+					r.destination = address_v4();
+					r.netmask = address_v4();
+					r.gateway = address_v4();
+					r.source_hint = local.address();
+					std::strncpy(r.name, it->name, sizeof(r.name) - 1);
+					r.mtu = 1500;
+					ret.push_back(r);
+				}
+			}
+		}
+
