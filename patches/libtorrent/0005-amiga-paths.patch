+#if defined TORRENT_AMIGA
+	// AmigaDOS: "Work:", "T:" or ":" is a volume's root, a path with a ':'
+	// before any '/' is complete, and no '/' goes after the ':' ("Work:/x"
+	// is the parent of Work:'s root)
+	namespace {
+		std::size_t amiga_colon(string_view f)
+		{
+			std::size_t const c = f.find(':');
+			std::size_t const s = f.find('/');
+			return (c != string_view::npos && (s == string_view::npos || c < s)) ? c : string_view::npos;
+		}
+	}
+#endif
+
 	bool is_root_path(std::string const& f)
 	{
 		if (f.empty()) return false;
+#if defined TORRENT_AMIGA
+		if (amiga_colon(f) == f.size() - 1) return true;
+#endif
 
 #if defined(TORRENT_WINDOWS) || defined(TORRENT_OS2)
 		// match \\ form
@@ -579,6 +596,10 @@ namespace {
 	{
 		if (f.empty()) return false;
 		if (is_root_path(f)) return false;
+#if defined TORRENT_AMIGA
+		// "Work:a" has the parent "Work:"
+		if (amiga_colon(f) != string_view::npos) return true;
+#endif
 
 		int len = int(f.size()) - 1;
 		// if the last character is / or \ ignore it
@@ -616,6 +637,14 @@ namespace {
 		}
 
 		if (f[std::size_t(len)] == '/' || f[std::size_t(len)] == '\\') ++len;
+#if defined TORRENT_AMIGA
+		// no '/' left: the parent of "Work:a" is "Work:"
+		if (len == 0)
+		{
+			std::size_t const c = amiga_colon(f);
+			if (c != string_view::npos && c + 1 < f.size()) return f.substr(0, c + 1);
+		}
+#endif
 		return std::string(f.c_str(), std::size_t(len));
 	}
 
@@ -627,6 +656,14 @@ namespace {
 #if defined(TORRENT_WINDOWS) || defined(TORRENT_OS2)
 		char const* altsep = std::strrchr(first, '\\');
 		if (sep == nullptr || altsep > sep) sep = altsep;
+#endif
+#if defined TORRENT_AMIGA
+		// "Work:a" is the file "a"; a root has no file name
+		if (sep == nullptr)
+		{
+			std::size_t const c = amiga_colon(f);
+			if (c != string_view::npos) return f.substr(c + 1);
+		}
 #endif
 		if (sep == nullptr) return f;
 
