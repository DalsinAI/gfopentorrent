index 7322038..2af0966 100644
--- a/include/libtorrent/config.hpp
+++ b/include/libtorrent/config.hpp
@@ -118,6 +118,13 @@ POSSIBILITY OF SUCH DAMAGE.
 #define TORRENT_HAVE_MMAP 0
 #define TORRENT_HAS_SYMLINK 0
 #define TORRENT_HAS_FALLOCATE 0
+// libnix has no getrlimit(): max_open_files() gives its fixed number
+#define TORRENT_USE_RLIMIT 0
+// no /dev/urandom, and libstdc++'s random_device has no source there:
+// crypto_random_bytes() takes gfot_entropy() (gfopentorrent compat/), and
+// random_engine() is seeded from it
+#define TORRENT_USE_DEV_RANDOM 0
+#define TORRENT_BROKEN_RANDOM_DEVICE 1
